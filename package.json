{
	"name": "ez-share",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": "22",
		"pnpm": "10"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "pnpm run test:integration && pnpm run test:unit",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"deploy:dev": "pnpm build && wrangler deploy --env dev",
		"deploy:prod": "pnpm build && wrangler deploy --env prod",
		"cf-typegen": "wrangler types --env dev",
		"studio:local": "drizzle-kit studio",
		"studio:dev": "drizzle-kit studio -- --dev",
		"studio:prod": "drizzle-kit studio -- --prod",
		"db:push": "drizzle-kit push",
		"migrations:generate": "drizzle-kit generate",
		"migrations:run:local": "drizzle-kit migrate",
		"migrations:run:dev": "drizzle-kit migrate -- --dev",
		"migrations:run:prod": "drizzle-kit migrate -- --prod",
		"prepare": "svelte-kit sync"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "5.1.1",
		"better-sqlite3": "11.10.0",
		"dotenv": "16.6.1",
		"drizzle-kit": "0.31.10",
		"prettier": "3.9.6",
		"prettier-plugin-organize-imports": "4.3.0",
		"prettier-plugin-svelte": "3.5.2",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"unocss": "66.10.0",
		"vite": "6.4.3",
		"vitest": "3.2.7",
		"wrangler": "4.129.0"
	},
	"dependencies": {
		"@unocss/reset": "66.10.0",
		"dayjs": "1.11.23",
		"drizzle-orm": "0.45.2",
		"zod": "3.25.76"
	}
}
